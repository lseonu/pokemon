      "rare": "#4060F0",
      "epic": "#9848D0",
      "legendary": "#F08030",
      "mythic": "#F0C030"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "'Press Start 2P', monospace",
      "secondary": "'Silkscreen', monospace",
      "mono": "'VT323', monospace"
    },
    "fontSize": {
      "xs": "8px",
      "sm": "12px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "40px"
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.6,
      "loose": 1.8
    },
    "letterSpacing": {
      "normal": 0,
      "tight": "-0.05em",
      "wide": "0.05em",
      "expanded": "0.1em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "borders": {
    "width": {
      "thin": "2px",
      "standard": "3px",
      "thick": "4px",
      "chunky": "6px"
    },
    "radius": {
      "none": "0",
      "sm": "2px",
      "md": "4px",
      "lg": "8px"
    }
  },
  "icons": {
    "size": {
      "xs": "16px",
      "sm": "24px",
      "md": "32px",
      "lg": "48px",
      "xl": "64px"
    }
  },
  "transitions": {
    "duration": {
      "fast": "150ms",
      "base": "250ms",
      "slow": "350ms"
    },
    "easing": {
      "default": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "in": "cubic-bezier(0.32, 0, 0.67, 0)",
      "out": "cubic-bezier(0.33, 1, 0.68, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  },
  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "overlay": 300,
    "modal": 400,
    "popover": 500,
    "tooltip": 600
  },
  "breakpoints": {
    "xs": "320px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1920px"
  }
}
